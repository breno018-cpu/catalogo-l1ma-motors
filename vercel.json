{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "template.html,data/**,public/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js?_route=/api/:path*" },
    { "source": "/moto/:path*", "destination": "/api/index.js?_route=/moto/:path*" },
    { "source": "/m/:path*", "destination": "/api/index.js?_route=/m/:path*" },
    { "source": "/produto/:path*", "destination": "/api/index.js?_route=/produto/:path*" },
    { "source": "/admin", "destination": "/api/index.js?_route=/admin" },
    { "source": "/index.html", "destination": "/api/index.js?_route=/" },
    { "source": "/", "destination": "/api/index.js?_route=/" }
  ]
}
