{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "template.html,data/**,public/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/moto/:path*", "destination": "/api/index.js" },
    { "source": "/m/:path*", "destination": "/api/index.js" },
    { "source": "/produto/:path*", "destination": "/api/index.js" },
    { "source": "/admin", "destination": "/api/index.js" },
    { "source": "/index.html", "destination": "/api/index.js" },
    { "source": "/", "destination": "/api/index.js" }
  ]
}
